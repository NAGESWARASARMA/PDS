# Flask Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_secure_random_hex_string_in_production

# Environment Mode
FLASK_ENV=production
FLASK_DEBUG=0

# Security Flags
COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax

# Storage Paths (Leave blank for defaults inside instance/)
# PDS_DB=instance/pds.sqlite3
# PDS_UPLOADS=instance/private_uploads
